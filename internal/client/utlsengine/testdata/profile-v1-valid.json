  "expected": {
    "normalization_version": "TLS-NORM-1",
    "materializer_version": "utls-materializer/1",
    "ja3_version": "ja3/1",
    "ja4_version": "ja4/1"
  },
  "engine": {
    "name": "uTLS",
    "version": "v1.8.2",
    "exporter": "JA3Proxy",
    "exporter_version": "1",
    "compatibility": "gocurl-utls/experimental"
  },
  "base_preset": {"client": "Chrome", "version": "120"},
  "host_patterns": ["example.test"],
  "replayability": {"status": "PARTIAL", "unsupported": ["fields.cipher_suites"], "warnings": ["cipher suites are inherited from the preset"]}
}
