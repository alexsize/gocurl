{
  "schema_version": "ja3proxy-client-profile/1",
  "id": "chrome-120-example",
  "version": 1,
  "name": "Chrome 120 example",
  "profile_type": "PRESET",
  "fields": {
    "cipher_suites": [4865, 4866, 4867],
    "supported_versions": [772, 771],
    "supported_groups": [29, 23],
    "signature_algorithms": [1027, 2052],
